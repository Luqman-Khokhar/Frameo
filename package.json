{
  "name": "frameo",
  "productName": "Frameo",
  "version": "0.3.0",
  "description": "Offline screenshot and screen-recording app. Its own controls never appear in captures.",
  "main": "src/main.js",
  "author": {
    "name": "Luqman Khokhar",
    "email": "mluqmangn@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "build:native": "make -C native",
    "start": "npm run build:native && electron .",
    "dist": "npm run build:native && electron-builder --linux deb AppImage",
    "test": "bash test/run.sh"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.frameo.desktop",
    "productName": "Frameo",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "synopsis": "Screenshots and screen recording",
      "desktop": {
        "entry": {
          "StartupWMClass": "frameo"
        }
      },
      "executableName": "frameo"
    },
    "deb": {
      "maintainer": "Luqman Khokhar <mluqmangn@gmail.com>",
      "depends": [
        "ffmpeg",
        "pulseaudio-utils",
        "libx11-6"
      ]
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/xcap",
        "to": "bin/xcap"
      }
    ]
  }
}
